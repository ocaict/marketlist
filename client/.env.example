# Frontend environment variables
# In local development you can leave this unset — the Vite dev server
# proxies /api to http://localhost:3600 (see client/vite.config.ts).
# For a deployed API, set the full URL, e.g.:
# VITE_API_URL=https://your-api.example.com/api
# For Android emulator builds, use the host loopback alias:
# VITE_API_URL=http://10.0.2.2:3600/api
